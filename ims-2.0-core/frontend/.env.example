# ============================================================================
# IMS 2.0 Frontend - Environment Configuration
# ============================================================================
# Copy this file to .env and update values for your environment

# API Configuration
VITE_API_URL=http://localhost:8000
VITE_API_VERSION=v1

# Application Settings
VITE_APP_NAME=IMS 2.0
VITE_APP_VERSION=2.0.0

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_AI_FEATURES=true

# Brand Configuration (BETTER_VISION | WIZOPT)
VITE_DEFAULT_BRAND=BETTER_VISION

# Session Configuration
VITE_SESSION_TIMEOUT=28800000
VITE_REFRESH_TOKEN_INTERVAL=300000

# Map Configuration (for store geo-fencing)
VITE_MAP_API_KEY=

# Sentry Error Tracking (optional)
VITE_SENTRY_DSN=

# Analytics (optional)
VITE_GA_TRACKING_ID=
