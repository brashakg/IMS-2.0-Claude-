# ============================================================================
# IMS 2.0 Backend - Environment Configuration
# ============================================================================
# Copy this file to .env and update values for your environment

# Application
APP_NAME=IMS 2.0 API
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://ims.bettervision.in"]

# Database - MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ims2
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50

# Cache - Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# ============================================================================
# Third-Party Integrations
# ============================================================================

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_STORE_URL=

# Tally Prime
TALLY_SERVER_URL=http://localhost:9000
TALLY_COMPANY_NAME=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Meta (Facebook) Ads
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# GST Portal
GST_API_URL=https://api.gst.gov.in
GST_USERNAME=
GST_PASSWORD=
GST_CLIENT_ID=
GST_CLIENT_SECRET=

# SMS Gateway (MSG91)
SMS_AUTH_KEY=
SMS_SENDER_ID=BVISION
SMS_ROUTE=4
SMS_TEMPLATE_ID=

# Email Service (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@bettervision.in
SENDGRID_FROM_NAME=Better Vision

# ============================================================================
# Storage
# ============================================================================

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ims-uploads

# ============================================================================
# Monitoring
# ============================================================================

# Sentry
SENTRY_DSN=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
